NODE_ENV=development
PORT=4173
APP_ORIGIN=http://localhost:4173

# sqlite para local/offline, postgres para SaaS/cloud
DB_CLIENT=sqlite
SQLITE_PATH=./data/daryez-smart-point.sqlite
DATABASE_URL=postgres://user:password@localhost:5432/daryez_smart_point

JWT_SECRET=change-this-secret-before-production
JWT_EXPIRES_IN=8h
PASSWORD_PEPPER=change-this-pepper-before-production

DEFAULT_TENANT_NAME=Daryez Demo
DEFAULT_ADMIN_EMAIL=admin@daryez.local
DEFAULT_ADMIN_PASSWORD=admin12345

STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
