	<parameter name="Fecha_fin" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select folio, us.codigo_acceso, fecha, hora, T_cont, T_calc, T_dif,T_cr from cat_cortes_caja  as cc inner join cat_usuarios as us
on us.id_us=cc.Cve_user
where cc.fecha between $P{Fecha_ini} and $P{Fecha_fin}
order by fecha desc, folio desc]]>
	</queryString>
	<field name="folio" class="java.lang.Integer"/>
	<field name="codigo_acceso" class="java.lang.String"/>
