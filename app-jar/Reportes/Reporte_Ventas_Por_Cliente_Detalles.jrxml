	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="Cliente" class="java.lang.String"/>
	<parameter name="Fecha_ini" class="java.util.Date"/>
	<parameter name="Fecha_fin" class="java.util.Date"/>
	<parameter name="Cve_cliente" class="java.lang.String"/>
	<parameter name="Efectivo" class="java.lang.String"/>
	<parameter name="Tarjeta" class="java.lang.String"/>
	<parameter name="Transfer" class="java.lang.String"/>
	<parameter name="Credito" class="java.lang.String"/>
	<parameter name="Total_importes" class="java.lang.String"/>
	<queryString>
		<![CDATA[select v.folio, SUM(v.total) as Total, v.fecha, v.hora from ventas as v
where  v.cve_cliente=$P{Cve_cliente} and fecha BETWEEN $P{Fecha_ini} and $P{Fecha_fin} and v.cancelado=0
group by v.folio, v.fecha, v.hora
order by Total asc]]>
	</queryString>
	<field name="folio" class="java.lang.Integer"/>
	<field name="Total" class="java.math.BigDecimal"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="hora" class="java.sql.Time"/>
	<variable name="Total_importe" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Total}]]></variableExpression>
	</variable>
