	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="Fecha_ini" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Fecha_fin" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Titulo" class="java.lang.String"/>
	<parameter name="Total_importe" class="java.lang.String"/>
	<queryString>
		<![CDATA[select c.fecha, c.folio, cl.nombre as cliente, c.total_mas_iva, c.observaciones from cotizaciones as c inner join cat_clientes as cl
on cl.id_cli = c.cve_cliente
where c.fecha between $P{Fecha_ini} and $P{Fecha_fin}
order by c.folio desc]]>
	</queryString>
	<field name="fecha" class="java.sql.Date"/>
	<field name="folio" class="java.lang.Integer"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="total_mas_iva" class="java.math.BigDecimal"/>
	<field name="observaciones" class="java.lang.String"/>
	<variable name="Total_importe" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{total_mas_iva}]]></variableExpression>
	</variable>
