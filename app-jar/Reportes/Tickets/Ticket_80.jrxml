	<queryString>
		<![CDATA[select distinct pro.clave,v.folio, vd.cantidad, pro.Descripcion, vd.precio, vd.subtotal, v.Fecha, v.hora, us.nombre from ventas as v inner join ventasdetalle as vd 
on v.folio=vd.folio inner join cat_productos as pro
on pro.Clave=vd.codigo inner join cat_usuarios as us
on us.id_us=v.cve_user
where v.Folio=$P{Folio}
order by pro.clave desc]]>
	</queryString>
	<field name="clave" class="java.lang.String"/>
	<field name="folio" class="java.lang.Integer"/>
	<field name="cantidad" class="java.math.BigDecimal"/>
