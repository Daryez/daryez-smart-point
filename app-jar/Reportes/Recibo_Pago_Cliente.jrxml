	<parameter name="Folio" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Direccion" class="java.lang.String"/>
	<parameter name="Empresa" class="java.lang.String"/>
	<parameter name="Ciudad" class="java.lang.String"/>
	<parameter name="Telefono" class="java.lang.String"/>
	<parameter name="Estatus" class="java.lang.String"/>
	<parameter name="Cant_letra" class="java.lang.String"/>
	<parameter name="RFC" class="java.lang.String"/>
	<parameter name="Email" class="java.lang.String"/>
	<parameter name="Saldo_adeudo" class="java.lang.String"/>
	<parameter name="Forma_pago" class="java.lang.String"/>
	<queryString>
		<![CDATA[select cl.Nombre as cliente, SUM(h.abono_cargo * -1) as importe, h.fecha, h.hora, h.comentarios, us.nombre as usuario from hist_pagos_credito as h inner join cat_clientes as cl
on cl.id_cli=h.Cve_cliente inner join cat_usuarios as us
on us.id_us=h.cve_usuario inner join formas_pago as fp
on fp.clave=h.Forma_pago
where h.movimiento='abono' and h.cancelado=$P{Estatus} and h.F_abono=$P{Folio}
group by h.F_abono, cl.Nombre, h.fecha, h.hora, h.comentarios, fp.nombre, us.nombre]]>
	</queryString>
	<field name="cliente" class="java.lang.String"/>
	<field name="importe" class="java.math.BigDecimal"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="hora" class="java.sql.Time"/>
	<field name="comentarios" class="java.lang.String"/>
	<field name="usuario" class="java.lang.String"/>
