	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Users\\ING CASTILLO\\Documents\\NetBeansProjects\\COLEGIO_SAN_JOSE\\src\\Reportes\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="Fecha_Ini" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Fecha_Fin" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Clave" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select cli.id_cli, cli.nombre as cliente, hist.fecha as fecha,hist.movimiento as movimiento, hist.saldo_anterior, hist.abono_cargo, hist.saldo_actual, hist.F_venta, hist.F_abono from hist_pagos_credito as hist inner join cat_clientes as cli
on cli.id_cli=hist.Cve_cliente inner join formas_pago as fp
on fp.clave=hist.Forma_pago
where hist.Cve_cliente=$P{Clave} and hist.fecha between $P{Fecha_Ini} and $P{Fecha_Fin}
order by hist.id_mov;]]>
	</queryString>
	<field name="id_cli" class="java.lang.String"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="movimiento" class="java.lang.String"/>
	<field name="saldo_anterior" class="java.math.BigDecimal"/>
	<field name="abono_cargo" class="java.math.BigDecimal"/>
	<field name="saldo_actual" class="java.math.BigDecimal"/>
	<field name="F_venta" class="java.lang.Integer"/>
	<field name="F_abono" class="java.lang.Integer"/>
	<variable name="Sumatoria" class="java.lang.Float" calculation="Sum">
		<variableExpression><![CDATA[$F{abono_cargo}]]></variableExpression>
	</variable>
