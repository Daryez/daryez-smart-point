	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="Cliente" class="java.lang.String"/>
	<parameter name="Fecha_ini" class="java.util.Date"/>
	<parameter name="Fecha_fin" class="java.util.Date"/>
	<parameter name="Status" class="java.lang.String"/>
	<parameter name="Titulo" class="java.lang.String"/>
	<parameter name="Pagos_total" class="java.lang.String"/>
	<queryString>
		<![CDATA[select h.F_abono, cl.Nombre, (h.abono_cargo* -1) as importe, h.fecha from hist_pagos_credito as h inner join cat_clientes as cl
on cl.id_cli=h.Cve_cliente inner join cat_usuarios as us
on us.id_us=h.cve_usuario inner join formas_pago as fp
on fp.clave=h.Forma_pago
where h.fecha between $P{Fecha_ini} and $P{Fecha_fin} and h.movimiento='abono' and h.cancelado=$P{Status} and cl.nombre like '%'+$P{Cliente}+'%'
order by h.f_abono asc]]>
	</queryString>
	<field name="F_abono" class="java.lang.Integer"/>
	<field name="Nombre" class="java.lang.String"/>
	<field name="importe" class="java.math.BigDecimal"/>
	<field name="fecha" class="java.sql.Date"/>
	<variable name="Pagos_total" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{importe}]]></variableExpression>
	</variable>
