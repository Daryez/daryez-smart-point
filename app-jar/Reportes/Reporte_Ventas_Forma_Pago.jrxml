	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="Fecha_ini" class="java.util.Date"/>
	<parameter name="Fecha_fin" class="java.util.Date"/>
	<parameter name="Factura" class="java.lang.String"/>
	<parameter name="Titulo" class="java.lang.String"/>
	<parameter name="Total_importes" class="java.lang.String"/>
	<queryString>
		<![CDATA[select fp.nombre as forma_pago, v.folio, cl.Nombre as nombre_cliente, v.total, v.fecha from ventas as v inner join formas_pago as fp 
on fp.clave=v.forma_pago inner join cat_clientes as cl
on cl.id_cli=v.cve_cliente
where fecha between $P{Fecha_ini} and $P{Fecha_fin} and v.facturado=$P{Factura}
group by fp.nombre, v.folio, cl.nombre, v.total, v.fecha]]>
	</queryString>
	<field name="forma_pago" class="java.lang.String"/>
	<field name="folio" class="java.lang.Integer"/>
	<field name="nombre_cliente" class="java.lang.String"/>
	<field name="total" class="java.math.BigDecimal"/>
	<field name="fecha" class="java.sql.Date"/>
	<variable name="Total_importe" class="java.lang.Double" resetType="Group" resetGroup="forma_pago" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
	<variable name="Total_importes" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
