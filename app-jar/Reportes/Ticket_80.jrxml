	<queryString>
		<![CDATA[select pro.clave,vd.folio, vd.cantidad, pro.Descripcion, vd.observaciones, vd.precio, vd.subtotal, vd.Fecha, vd.hora from ventasdetalle as vd inner join cat_productos as pro
on pro.Clave=vd.codigo
where vd.Folio=$P{Folio}
order by pro.clave desc]]>
	</queryString>
	<field name="clave" class="java.lang.String"/>
	<field name="folio" class="java.lang.Integer"/>
	<field name="cantidad" class="java.math.BigDecimal"/>
	<field name="Descripcion" class="java.lang.String"/>
