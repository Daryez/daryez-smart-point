	<queryString>
		<![CDATA[select pro.clave, vd.folio, vd.cantidad, pro.Descripcion, vd.observaciones, vd.precio, vd.subtotal, vd.Fecha from ventasdetalle as vd 
inner join cat_productos as pro
on pro.Clave=vd.codigo
where Folio=$P{Folio}
order by pro.clave DESC]]>
	</queryString>
	<field name="clave" class="java.lang.String"/>
	<field name="folio" class="java.lang.Integer"/>
	<field name="cantidad" class="java.math.BigDecimal"/>
