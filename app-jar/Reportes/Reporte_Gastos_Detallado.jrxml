	<property name="ireport.y" value="0"/>
	<parameter name="Fecha_ini" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Fecha_fin" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Rubro" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Total_importes" class="java.lang.String"/>
	<queryString>
		<![CDATA[select rubro, folio,descr_detalle,fecha,importe from gastos as g inner join cat_rubros as r 
on r.codigo=g.codigo
where fecha between $P{Fecha_ini} and $P{Fecha_fin} and rubro like '%'+$P{Rubro}+'%'
group by r.rubro,g.folio,g.descr_detalle,g.fecha,g.importe]]>
	</queryString>
	<field name="rubro" class="java.lang.String"/>
	<field name="folio" class="java.lang.Integer"/>
	<field name="descr_detalle" class="java.lang.String"/>
	<field name="fecha" class="java.sql.Date"/>
	<field name="importe" class="java.math.BigDecimal"/>
	<variable name="Total_Importe" class="java.lang.Float" resetType="Group" resetGroup="rubro" calculation="Sum">
		<variableExpression><![CDATA[$F{importe}]]></variableExpression>
	</variable>
	<variable name="Total_Importes" class="java.lang.Float" calculation="Sum">
		<variableExpression><![CDATA[$F{importe}]]></variableExpression>
	</variable>
