<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="612" pageHeight="842" columnWidth="572" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="4f918cdc-58c0-4118-85a8-64fa9de74688">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="Fecha_ini" class="java.util.Date"/>
	<parameter name="Fecha_fin" class="java.util.Date"/>
	<parameter name="Titulo" class="java.lang.String"/>
	<parameter name="Ventas" class="java.lang.String"/>
	<parameter name="Recuperacion" class="java.lang.String"/>
	<parameter name="Ganancia" class="java.lang.String"/>
	<queryString>
		<![CDATA[select  pr.clave, pr.Descripcion, sum(vd.cantidad) as Cant_total, sum(vd.subtotal) as Precio, sum(pr.costo*vd.cantidad) as Costo, (Sum(vd.subtotal) - Sum(pr.Costo*vd.cantidad)) as Ganancia  from ventasdetalle as vd inner join cat_productos as pr
on pr.Clave=vd.codigo
where pr.servicio=0 and cancelado=0 and vd.fecha BETWEEN $P{Fecha_ini} and $P{Fecha_fin} 
group by pr.clave, pr.Descripcion
order by Cant_total desc]]>
	</queryString>
	<field name="clave" class="java.lang.String"/>
	<field name="Descripcion" class="java.lang.String"/>
	<field name="Cant_total" class="java.math.BigDecimal"/>
	<field name="Precio" class="java.math.BigDecimal"/>
	<field name="Costo" class="java.math.BigDecimal"/>
	<field name="Ganancia" class="java.math.BigDecimal"/>
	<variable name="Cantidad" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Cant_total}]]></variableExpression>
	</variable>
	<variable name="Ventas" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Precio}]]></variableExpression>
	</variable>
	<variable name="Recuperacion" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Costo}]]></variableExpression>
	</variable>
	<variable name="Ganacia" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Ganancia}]]></variableExpression>
	</variable>
