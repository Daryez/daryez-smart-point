	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="Fecha_ini" class="java.util.Date"/>
	<parameter name="Fecha_fin" class="java.util.Date"/>
	<parameter name="Titulo" class="java.lang.String"/>
	<parameter name="Total_importes" class="java.lang.String"/>
	<queryString>
		<![CDATA[select cli.nombre as cliente,vd.folio, vd.cantidad as cantidad, pr.Clave, pr.Descripcion, pr.Precio, vd.subtotal as subtotal from ventasdetalle as vd inner join cat_productos as pr
on pr.Clave=vd.codigo inner join ventas as v
on v.folio=vd.folio inner join cat_clientes as cli
on cli.id_cli=v.cve_cliente
where vd.fecha BETWEEN $P{Fecha_ini} and $P{Fecha_fin} and vd.codigo not in('000000000')
group by cli.Nombre,vd.folio, vd.cantidad, pr.Clave, pr.Descripcion, pr.precio, vd.subtotal]]>
	</queryString>
	<field name="cliente" class="java.lang.String"/>
	<field name="folio" class="java.lang.Integer"/>
	<field name="cantidad" class="java.math.BigDecimal"/>
	<field name="Clave" class="java.lang.String"/>
	<field name="Descripcion" class="java.lang.String"/>
	<field name="Precio" class="java.math.BigDecimal"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<variable name="Sumatoria" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
	</variable>
	<variable name="Suma" class="java.lang.Double" resetType="Group" resetGroup="cliente" calculation="Sum">
		<variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
	</variable>
