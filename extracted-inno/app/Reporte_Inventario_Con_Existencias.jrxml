	<parameter name="Proveedor" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select pr.clave, pr.descripcion, pr.stock from cat_productos as pr inner join cat_proveedores as prov
on prov.Id_prov=pr.cve_proveedor
WHERE prov.Nombre LIKE $P{Proveedor}+'%' and pr.servicio=0 and pr.Stock > 0]]>
	</queryString>
	<field name="clave" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="stock" class="java.math.BigDecimal"/>
	<variable name="Total_existencias" class="java.lang.Double" calculation="Sum">
