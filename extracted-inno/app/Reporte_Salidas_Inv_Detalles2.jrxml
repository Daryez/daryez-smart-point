		<![CDATA[select inv.folio, inv.Fecha, inv.comentarios, pr.clave, pr.Descripcion, invd.cantidad from salidas_inventario_detalle as invd inner join salidas_inventario as inv
on inv.folio=invd.folio inner join cat_productos as pr
on pr.Clave=invd.Cve_prod where inv.Fecha between $P{Fecha_ini} and $P{Fecha_fin}]]>
	</queryString>
