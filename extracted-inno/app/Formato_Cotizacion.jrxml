	<queryString>
		<![CDATA[select pro.clave, vd.folio, vd.cantidad, pro.Descripcion, vd.observaciones,  vd.precio, vd.subtotal, vd.Fecha from cotizaciondetalle as vd 
inner join cat_productos as pro
on pro.Clave=vd.codigo
where Folio=$P{Folio}
order by pro.clave DESC]]>
	</queryString>
	<field name="clave" class="java.lang.String"/>
	<field name="folio" class="java.lang.Integer"/>
	<field name="cantidad" class="java.math.BigDecimal"/>
	<field name="Descripcion" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="precio" class="java.math.BigDecimal"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<field name="Fecha" class="java.sql.Date"/>
	<variable name="TOTAL" class="java.lang.Float" calculation="Sum">
		<variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
	</variable>
