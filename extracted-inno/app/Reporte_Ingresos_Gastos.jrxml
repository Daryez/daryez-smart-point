	<queryString>
		<![CDATA[select fp.nombre, SUM(v.total) as Total_importe from ventas as v inner join formas_pago as fp
on fp.clave=v.forma_pago
where cancelado=0 and v.forma_pago not in('0') and fecha BETWEEN $P{Fecha_ini} and  $P{Fecha_fin}
group by fp.nombre]]>
	</queryString>
	<field name="nombre" class="java.lang.String"/>
	<field name="Total_importe" class="java.math.BigDecimal"/>
	<variable name="Sumatoria_Ingresos" class="java.lang.Double" calculation="Sum">
		<variableExpression><![CDATA[$F{Total_importe}]]></variableExpression>
	</variable>
