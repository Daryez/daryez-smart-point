	<parameter name="Fecha_ini" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Fecha_fin" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Titulo" class="java.lang.String"/>
	<parameter name="Status" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Cliente" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Efectivo" class="java.lang.String"/>
	<parameter name="Tarjeta" class="java.lang.String"/>
	<parameter name="Transfer" class="java.lang.String"/>
	<parameter name="Credito" class="java.lang.String"/>
	<parameter name="Total_ventas" class="java.lang.String"/>
	<queryString>
		<![CDATA[select v.folio, cli.Nombre, SUM(v.total) AS total, v.fecha from ventas as v inner join cat_clientes as cli 
on cli.id_cli=v.cve_cliente
where  v.fecha between $P{Fecha_ini} and $P{Fecha_fin} and cli.Nombre LIKE '%'+$P{Cliente}+'%' and v.cancelado=$P{Status} 
GROUP BY v.folio, cli.Nombre, v.fecha
order by v.folio;]]>
	</queryString>
	<field name="folio" class="java.lang.Integer"/>
	<field name="Nombre" class="java.lang.String"/>
	<field name="total" class="java.math.BigDecimal"/>
	<field name="fecha" class="java.sql.Date"/>
	<variable name="Ventas_Total" class="java.lang.Float" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
	</variable>
