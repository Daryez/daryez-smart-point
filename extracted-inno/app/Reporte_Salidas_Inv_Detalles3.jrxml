	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="Fecha_ini" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Fecha_fin" class="java.util.Date">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="Titulo" class="java.lang.String"/>
	<queryString>
		<![CDATA[select pr.clave, pr.Descripcion, sum(invd.cantidad)  as cantidad from salidas_inventario_detalle as invd inner join salidas_inventario as inv
on inv.folio=invd.folio inner join cat_productos as pr
on pr.Clave=invd.Cve_prod
where inv.Fecha between $P{Fecha_ini} and $P{Fecha_fin}
group by pr.clave, pr.Descripcion]]>
	</queryString>
	<field name="clave" class="java.lang.String"/>
	<field name="Descripcion" class="java.lang.String"/>
	<field name="cantidad" class="java.math.BigDecimal"/>
